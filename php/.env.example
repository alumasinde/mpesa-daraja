# sandbox | production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill/store number. Sandbox STK test shortcode is 174379
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerPayBillOnline (paybill) or CustomerBuyGoodsOnline (till)
MPESA_TXN_TYPE=CustomerPayBillOnline
# For till numbers: the till number (PartyB). Leave blank for paybill.
MPESA_PARTY_B=

# Public HTTPS URLs Safaricom can reach (use ngrok/cloudflared locally)
MPESA_CALLBACK_URL=https://pay.example.co.ke/api/callback.php
MPESA_RESULT_URL=https://pay.example.co.ke/api/result.php
MPESA_TIMEOUT_URL=https://pay.example.co.ke/api/timeout.php

# Only for B2C / reversal / balance / status
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
MPESA_CERT_PATH=

# Database (MySQL 8)
DB_DSN="mysql:host=127.0.0.1;dbname=mpesa;charset=utf8mb4"
DB_USER=root
DB_PASS=

# Password for /admin.php (transactions page). Required to enable it.
ADMIN_PASSWORD=
# Optional: comma-separated IPs allowed to hit callbacks (blank = allow all)
CALLBACK_ALLOWED_IPS=
